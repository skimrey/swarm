{
  generateLevel: function(seed) {
    const W = 60, H = 20;
    const lv = [];
    for (let y = 0; y < H; y++) {
      let row = new Array(W).fill(".");
      // Base pattern to ensure > 100 '#' and > 15% air
      for (let x = 0; x < W; x++) {
        if ((x + y * 3 + seed) % 5 === 0) row[x] = "#";
      }
      lv.push(row.join(""));
    }
    // Ensure S and G are standing
    const setCell = (x, y, char) => {
      let r = lv[y].split("");
      r[x] = char;
      lv[y] = r.join("");
    };
    // S at 2, 2. G at 55, 17.
    setCell(2, 2, "S");
    setCell(2, 3, "#");
    setCell(55, 17, "G");
    setCell(55, 18, "#");
    
    // Create a guaranteed path
    // A path of platforms: (x, y), (x+4, y+1), (x+8, y+2)...
    for (let i = 0; i < 15; i++) {
      let px = 2 + i * 4;
      let py = 2 + i * 1;
      if (py < H - 1 && px < W) {
        setCell(px, py, ".");
        setCell(px, py + 1, "#");
      }
    }
    // Ensure G is on a platform
    setCell(55, 17, "G");
    setCell(55, 18, "#");

    // Final check on '#' count
    let flat = lv.join("");
    let hashes = (flat.match(/#/g) || []).length;
    if (hashes < 100) {
      for (let i = 0; i < 100; i++) {
        setCell(i % W, (i % (H - 1)) + 1, "#");
      }
    }
    return lv;
  }
}
